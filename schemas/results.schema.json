{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fallsense/results.schema.json",
  "title": "FallSense results.json",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "status",
    "model",
    "task",
    "git_commit",
    "config_hash",
    "split_checksum",
    "data_manifest_checksum",
    "evaluation_protocol",
    "per_subject",
    "aggregate"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["RUN", "NOT RUN", "QUICK-MODE-ONLY"] },
    "model": { "type": "string" },
    "task": { "type": "string" },
    "git_commit": { "type": "string", "minLength": 7 },
    "config_hash": { "type": "string", "minLength": 16 },
    "split_checksum": { "type": "string", "minLength": 16 },
    "data_manifest_checksum": { "type": "string", "minLength": 16 },
    "evaluation_protocol": { "type": "string" },
    "per_subject": { "type": "array", "items": { "type": "object" } },
    "aggregate": { "type": "object", "required": ["macro_f1"] }
  },
  "additionalProperties": true
}
